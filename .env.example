FLASK_ENV=development
SECRET_KEY=change-this-to-a-long-random-secret

# mysql = XAMPP MySQL/MariaDB (falls back to SQLite automatically if MySQL is off)
# sqlite = no database server needed (instance/sonicsentinel.db)
DB_ENGINE=mysql
SQLITE_FALLBACK=1
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=sonicsentinel
DB_USER=root
DB_PASSWORD=

MAX_UPLOAD_MB=50
UPLOAD_FOLDER=uploads

# Default administrator created by scripts/init_db.py
ADMIN_EMAIL=admin@sonicsentinel.local
ADMIN_PASSWORD=Admin@12345
